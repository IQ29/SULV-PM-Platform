{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=sulv-pm-platform-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name sulv-pm-platform",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean:port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000 || true",
    "db:migrate:local": "wrangler d1 migrations apply sulv-pm-platform-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply sulv-pm-platform-production",
    "db:console:local": "wrangler d1 execute sulv-pm-platform-production --local",
    "db:console:prod": "wrangler d1 execute sulv-pm-platform-production"
  },
  "dependencies": {
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
